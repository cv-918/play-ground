{
  "schema_version": 1,
  "enabled": false,
  "command": "codex",
  "args": [
    "-m",
    "gpt-5.5",
    "--sandbox",
    "workspace-write",
    "--ask-for-approval",
    "never",
    "exec",
    "-"
  ],
  "prompt_input_mode": "stdin_text",
  "append_prompt_file": false,
  "working_directory": ".",
  "timeout_seconds": 900,
  "allowed_task_statuses": [
    "ready_for_implementation",
    "in_progress"
  ],
  "require_backlog_approval": true,
  "capture_changed_files": true,
  "capture_diff_snapshot": true
}
