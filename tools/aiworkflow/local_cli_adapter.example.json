{
  "schema_version": 1,
  "enabled": false,
  "allowed_task_statuses": [
    "ready_for_implementation",
    "in_progress"
  ],
  "require_backlog_approval": true,
  "commands": [
    {
      "command_id": "node_version",
      "enabled": true,
      "description": "Print the installed Node.js version for local adapter smoke checks.",
      "command": "node",
      "args": [
        "--version"
      ],
      "working_directory": ".",
      "timeout_seconds": 10,
      "env": {},
      "capture_changed_files": true,
      "capture_diff_snapshot": true
    }
  ]
}
