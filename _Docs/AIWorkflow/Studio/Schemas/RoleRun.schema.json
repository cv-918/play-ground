{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiworkflow.local/studio/schemas/RoleRun.schema.json",
  "title": "RoleRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role_run_id",
    "agent_id",
    "context_packet_ref",
    "work_order_id",
    "meeting_id",
    "input_context_refs",
    "prompt_ref",
    "model_provider",
    "model_name",
    "reasoning_level",
    "output_refs",
    "tool_run_refs",
    "evidence_refs",
    "status"
  ],
  "properties": {
    "role_run_id": { "type": "string", "pattern": "^RR-[0-9]{8}-[0-9]{6}-[a-z0-9][a-z0-9-]*$" },
    "agent_id": { "type": "string" },
    "context_packet_ref": { "type": "string" },
    "work_order_id": { "type": "string" },
    "meeting_id": { "type": ["string", "null"] },
    "input_context_refs": { "type": "array", "items": { "type": "string" } },
    "prompt_ref": { "type": "string" },
    "model_provider": { "type": "string" },
    "model_name": { "type": "string" },
    "reasoning_level": { "type": "string", "enum": ["none", "minimal", "low", "medium", "high", "xhigh"] },
    "output_refs": { "type": "array", "items": { "type": "string" } },
    "tool_run_refs": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "context_loaded",
        "planning",
        "tool_review",
        "running",
        "handoff_pending",
        "output_ready",
        "needs_director_decision",
        "completed",
        "blocked",
        "failed",
        "cancelled"
      ]
    }
  }
}
