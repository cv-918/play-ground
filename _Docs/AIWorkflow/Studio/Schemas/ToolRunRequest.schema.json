{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiworkflow.local/studio/schemas/ToolRunRequest.schema.json",
  "title": "ToolRunRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_run_request_id",
    "requester_type",
    "requester_ref",
    "tool_adapter_id",
    "requested_action",
    "permission_class",
    "purpose",
    "input_refs",
    "expected_outputs",
    "evidence_requirements",
    "approval_ref",
    "status",
    "created_at"
  ],
  "properties": {
    "tool_run_request_id": {
      "type": "string",
      "pattern": "^TRQ-[0-9]{8}-[0-9]{6}-[a-z0-9][a-z0-9-]*$"
    },
    "requester_type": {
      "type": "string",
      "enum": ["human_director", "staff_agent", "role_run", "work_order", "system"]
    },
    "requester_ref": { "type": "string", "minLength": 1 },
    "work_order_id": {
      "type": ["string", "null"],
      "pattern": "^WO-[0-9]{8}-[0-9]{6}-[a-z0-9][a-z0-9-]*$"
    },
    "role_run_id": {
      "type": ["string", "null"],
      "pattern": "^RR-[0-9]{8}-[0-9]{6}-[a-z0-9][a-z0-9-]*$"
    },
    "tool_adapter_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$" },
    "requested_action": { "type": "string", "minLength": 1 },
    "command_id": { "type": ["string", "null"] },
    "permission_class": {
      "type": "string",
      "enum": ["read", "write", "execute", "external", "destructive"]
    },
    "purpose": { "type": "string", "minLength": 1 },
    "input_refs": { "type": "array", "items": { "type": "string" } },
    "expected_outputs": { "type": "array", "items": { "type": "string" } },
    "evidence_requirements": { "type": "array", "items": { "type": "string" } },
    "approval_ref": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "director_review",
        "approved_for_execution",
        "blocked",
        "superseded",
        "cancelled"
      ]
    },
    "created_at": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
