{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiworkflow.local/studio/schemas/MeetingSession.schema.json",
  "title": "MeetingSession",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meeting_id",
    "topic",
    "meeting_type",
    "participants",
    "chair_agent_id",
    "director_user_id",
    "agenda",
    "known_constraints",
    "loaded_context_refs",
    "discussion_turns",
    "proposals",
    "objections",
    "unresolved_questions",
    "director_decisions",
    "accepted_directions",
    "rejected_directions",
    "follow_up_workorders",
    "minutes_artifact",
    "status"
  ],
  "properties": {
    "meeting_id": { "type": "string", "pattern": "^MEET-[0-9]{8}-[0-9]{6}-[a-z0-9][a-z0-9-]*$" },
    "topic": { "type": "string", "minLength": 1 },
    "meeting_type": { "type": "string", "enum": ["creative", "technical", "production", "review", "qa_triage", "postmortem", "release_readiness"] },
    "participants": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "chair_agent_id": { "type": "string" },
    "director_user_id": { "type": "string" },
    "agenda": { "type": "array", "items": { "type": "string" } },
    "known_constraints": { "type": "array", "items": { "type": "string" } },
    "loaded_context_refs": { "type": "array", "items": { "type": "string" } },
    "discussion_turns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["turn_id", "speaker_id", "turn_type", "content"],
        "properties": {
          "turn_id": { "type": "string" },
          "speaker_id": { "type": "string" },
          "turn_type": { "type": "string", "enum": ["brief", "proposal", "objection", "question", "answer", "synthesis", "decision_note"] },
          "content": { "type": "string" },
          "source_refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "proposals": { "type": "array", "items": { "type": "string" } },
    "objections": { "type": "array", "items": { "type": "string" } },
    "unresolved_questions": { "type": "array", "items": { "type": "string" } },
    "director_decisions": { "type": "array", "items": { "type": "string" } },
    "accepted_directions": { "type": "array", "items": { "type": "string" } },
    "rejected_directions": { "type": "array", "items": { "type": "string" } },
    "follow_up_workorders": { "type": "array", "items": { "type": "string" } },
    "minutes_artifact": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "context_loaded",
        "in_progress",
        "director_decision_needed",
        "follow_up_tasking",
        "closed",
        "blocked",
        "cancelled"
      ]
    }
  }
}
