      "blocked_actions": ["unapproved source changes", "unapproved canon writes", "unapproved commit or push", "secret exposure"],
      "approval_required_actions": ["source write", "runtime behavior change", "schema change", "external network dependency", "commit or push"],
      "input_contract": ["StaffContextPacket", "AIWorkflow Goal Request", "approved scope", "non-goals", "validation plan"],
