      "can_call_external": false,
      "can_incur_cost": false,
      "requires_human_approval": true,
      "default_enabled": true,
      "notes": [
        "Primary route for LLM-required work under the current user policy.",
        "Must stay under workflow governance and approval gates."
      ]
    },
